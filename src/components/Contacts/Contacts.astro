---
import styles from './Contacts.module.css';

// Jitter determinístico (mismo resultado en cada build/request)
const seed = (n: number) => {
  const x = Math.sin(n * 12.9898) * 43758.5453;
  return x - Math.floor(x);
};

// Forma de cada burbuja/panel: paralelogramo asimétrico (4 puntos, SIN
// muescas ni cortes) inclinado y deformado — mismo lenguaje que
// backgroundWhite/backgroundBlack de TextBox.module.css. Devuelve el
// clip-path y la rotación por separado: se usan en DOS capas apiladas
// (borde detrás + relleno encima, levemente más chico) para que el
// "borde" se vea parejo incluso en las esquinas deformadas — el border
// normal de CSS no sigue bien un clip-path irregular.
function bubbleShape(n: number) {
  const j = (k: number) => seed(n * 5 + k);
  const tlX = (1 + j(1) * 5).toFixed(1);
  const trY = (j(2) * 2.5).toFixed(1);
  const brX = (90 + j(3) * 6).toFixed(1);
  const blY = (88 + j(4) * 8).toFixed(1);
  const rotate = ((j(5) - 0.5) * 4).toFixed(2);
  const clipPath = `polygon(${tlX}% ${trY}%, 100% 0%, ${brX}% 100%, 0% ${blY}%)`;
  return { clipPath, rotate };
}

---

<section class={styles.contacts} id="Contacts">

  <!-- ══ FONDO — por ahora, solo un rojo que se vuelve más opaco hacia
       el centro (vértice), sin el dibujo de la torre/ciudad todavía ══ -->
  <div class={styles.bg} aria-hidden="true">
    <div class={styles.vignette}></div>
    <div class={styles.scanlines}></div>
  </div>

  <!-- ══ HEADER ══ -->
  <div class={styles.header} aria-hidden="true">
    <div class={styles.headerSlash}></div>
    <div class={styles.headerSlashWhite}></div>
    <div class={styles.headerRed}></div>
    <div class={styles.titleCollage}>
      {'CONTACT'.split('').map((l, i) => (
        <span
          class={styles.titleLetter}
          style={`--angle: ${[-7,6,-9,4,-6,8,-5][i]}deg; --i: ${i}`}
        >{l}</span>
      ))}
    </div>
  </div>

  <!-- ══ TELÉFONO — panel rojo con capas blanca/negra detrás (más grande, ══
       rotado a la derecha) + pantalla oscura para el chat ══ -->
  <div class={styles.panelWrap}>
    <div class={styles.phoneFrame}>
      <div class={styles.frameBlack} aria-hidden="true"></div>
      <div class={styles.frameWhite} aria-hidden="true"></div>
      <div class={styles.frameRed}>
      <div class={styles.phoneScreen}>
        <span class={styles.commIcon} aria-hidden="true">
          <svg viewBox="0 0 24 24" class={styles.commIconSvg}>
            <path fill="currentColor" d="M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H9l-5 4v-4H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/>
          </svg>
        </span>
        <span class={styles.commName}>AL.DEV</span>
        <a
          class={styles.commGithub}
          href="https://github.com/TiL3Ss"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ver perfil de GitHub"
        >
          <svg viewBox="0 0 24 24" class={styles.commGithubIcon} aria-hidden="true">
            <path fill="currentColor" d="M12 .5C5.73.5.98 5.24.98 11.52c0 4.94 3.2 9.13 7.65 10.6.56.1.76-.24.76-.53 0-.26-.01-1.12-.02-2.03-3.11.68-3.77-1.32-3.77-1.32-.5-1.28-1.23-1.62-1.23-1.62-1-.69.08-.68.08-.68 1.11.08 1.7 1.14 1.7 1.14.98 1.68 2.58 1.2 3.21.92.1-.71.39-1.2.7-1.48-2.48-.28-5.1-1.24-5.1-5.53 0-1.22.44-2.22 1.15-3-.11-.28-.5-1.42.11-2.96 0 0 .95-.3 3.1 1.15a10.7 10.7 0 0 1 5.64 0c2.15-1.45 3.1-1.15 3.1-1.15.61 1.54.22 2.68.11 2.96.72.78 1.15 1.78 1.15 3 0 4.3-2.63 5.24-5.13 5.52.4.35.76 1.04.76 2.1 0 1.52-.01 2.74-.01 3.11 0 .29.2.64.77.53 4.44-1.48 7.64-5.66 7.64-10.6C23.02 5.24 18.27.5 12 .5Z"/>
          </svg>
        </a>

        <form class={styles.chatThread} id="contactForm" novalidate>
        <div class={styles.msgRow} style="--d: 0" data-bubble-bot-template>
          <span class={styles.msgAvatar}>AL</span>
          <p class={`${styles.msgBubble} ${styles.msgIncoming}`} style={bubbleShape(1)}>¿Cómo te llamas?</p>
        </div>
        <label class={`${styles.msgRow} ${styles.msgRowOut}`} style="--d: 1">
          <input
            class={`${styles.msgBubble} ${styles.msgOutgoing} ${styles.msgInput}`}
            style={bubbleShape(2)}
            type="text"
            id="cf-name"
            name="name"
            autocomplete="name"
            required
            maxlength="200"
            placeholder="Escribe tu nombre…"
          />
        </label>

        <div class={styles.msgRow} style="--d: 2">
          <span class={styles.msgAvatar}>AL</span>
          <p class={`${styles.msgBubble} ${styles.msgIncoming}`} style={bubbleShape(3)}>¿Cuál es tu correo?</p>
        </div>
        <label class={`${styles.msgRow} ${styles.msgRowOut}`} style="--d: 3">
          <input
            class={`${styles.msgBubble} ${styles.msgOutgoing} ${styles.msgInput}`}
            style={bubbleShape(4)}
            type="email"
            id="cf-email"
            name="email"
            autocomplete="email"
            required
            maxlength="200"
            placeholder="tucorreo@ejemplo.com"
          />
        </label>

        <div class={styles.msgRow} style="--d: 4">
          <span class={styles.msgAvatar}>AL</span>
          <p class={`${styles.msgBubble} ${styles.msgIncoming}`} style={bubbleShape(5)}>Cuéntame en qué puedo ayudarte</p>
        </div>
        <label class={`${styles.msgRow} ${styles.msgRowOut}`} style="--d: 5">
          <textarea
            class={`${styles.msgBubble} ${styles.msgOutgoing} ${styles.msgInput} ${styles.msgTextarea}`}
            style={bubbleShape(6)}
            id="cf-message"
            name="message"
            required
            maxlength="5000"
            rows="3"
            placeholder="Escribe tu mensaje…"
          ></textarea>
        </label>

        <p class={styles.statusLine} id="cf-status" role="status" aria-live="polite"></p>

        <div class={styles.commFooter} id="chatInputBar">
          <span class={styles.commFooterHint}>Toca Enviar para transmitir tu mensaje</span>
          <button type="submit" class={styles.sendBtn} id="cf-submit" aria-label="Enviar mensaje">
            <span data-state="idle" class={styles.sendLabel}>Enviar</span>
            <span data-state="sending" class={styles.sendSpinner} hidden></span>
          </button>
        </div>
        </form>
      </div>
      </div>
    </div>
  </div>

  <div class={styles.bottomBand} aria-hidden="true"></div>

</section>

<script>
  const init = () => {
    const form   = document.getElementById('contactForm') as HTMLFormElement | null;
    const submit = document.getElementById('cf-submit') as HTMLButtonElement | null;
    const status = document.getElementById('cf-status');
    const inputBar = document.getElementById('chatInputBar');
    const botTemplate = document.querySelector('[data-bubble-bot-template]') as HTMLElement | null;
    if (!form || !submit || !status || !inputBar || !botTemplate) return;

    const idleLabel    = submit.querySelector('[data-state="idle"]') as HTMLElement | null;
    const sendingLabel = submit.querySelector('[data-state="sending"]') as HTMLElement | null;

    const setSending = (sending: boolean) => {
      submit.disabled = sending;
      if (idleLabel)    idleLabel.hidden    = sending;
      if (sendingLabel) sendingLabel.hidden = !sending;
    };

    const setStatus = (msg: string, kind: 'error' | '') => {
      status.textContent = msg;
      if (kind) status.dataset.kind = kind; else status.removeAttribute('data-kind');
    };

    // Clona la burbuja del bot ya existente en el markup (misma clase CSS
    // module hasheada, sin necesidad de conocer su nombre desde el JS) y
    // la inserta justo antes de la barra de envío.
    let botCount = 0;
    const addBotBubble = (text: string) => {
      const clone = botTemplate.cloneNode(true) as HTMLElement;
      clone.removeAttribute('data-bubble-bot-template');
      botCount += 1;
      clone.style.setProperty('--d', String(botCount));
      const textEl = clone.querySelector('p');
      if (textEl) textEl.textContent = text;
      inputBar.parentElement?.insertBefore(clone, inputBar);
      clone.scrollIntoView({ behavior: 'smooth', block: 'end' });
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      setStatus('', '');

      const nameEl    = document.getElementById('cf-name')    as HTMLInputElement;
      const emailEl   = document.getElementById('cf-email')   as HTMLInputElement;
      const messageEl = document.getElementById('cf-message') as HTMLTextAreaElement;
      const name    = nameEl.value.trim();
      const email   = emailEl.value.trim();
      const message = messageEl.value.trim();

      if (!name || !email || !message) {
        setStatus('Completa los 3 campos antes de enviar', 'error');
        return;
      }

      setSending(true);
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, message }),
        });
        const data = await res.json().catch(() => ({}));

        if (!res.ok) {
          setStatus(data.error ?? 'No se pudo enviar — intenta de nuevo', 'error');
          return;
        }

        addBotBubble('¡Recibido! Te respondo apenas pueda 🙌');
        form.reset();
      } catch {
        setStatus('Error de conexión — intenta de nuevo', 'error');
      } finally {
        setSending(false);
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
        <!-- Animaciones CSS inline para ventanas y antenas -->
        <style>{`
          /* Parpadeo ventanas — grupos con fases distintas */
          .winGroup1 { animation: winFlicker1 3.8s ease-in-out infinite; }
          .winGroup2 { animation: winFlicker2 4.2s ease-in-out infinite 0.7s; }
          .winGroup3 { animation: winFlicker3 3.5s ease-in-out infinite 1.4s; }
          .winGroup4 { animation: winFlicker4 4.6s ease-in-out infinite 0.3s; }

          @keyframes winFlicker1 {
            0%,100% { opacity: 0.88; }
            20%      { opacity: 1.00; }
            35%      { opacity: 0.55; }
            55%      { opacity: 0.92; }
            75%      { opacity: 0.70; }
          }
          @keyframes winFlicker2 {
            0%,100% { opacity: 0.85; }
            15%      { opacity: 0.60; }
            40%      { opacity: 1.00; }
            65%      { opacity: 0.75; }
            85%      { opacity: 0.95; }
          }
          @keyframes winFlicker3 {
            0%,100% { opacity: 0.82; }
            25%      { opacity: 1.00; }
            50%      { opacity: 0.50; }
            70%      { opacity: 0.90; }
          }
          @keyframes winFlicker4 {
            0%,100% { opacity: 0.82; }
            30%      { opacity: 0.55; }
            55%      { opacity: 1.00; }
            80%      { opacity: 0.78; }
          }

          /* Antenas — baliza roja estilo señalización */
          /* transform-box fill-box permite que scale() opere
             desde el centro geométrico de cada polígono */
          .ant1, .ant2, .ant3, .ant1Halo, .ant2Halo, .ant3Halo {
            transform-box:    fill-box;
            transform-origin: center;
          }
          .ant1      { animation: antBlink1 1.8s ease-in-out infinite; }
          .ant1Halo  { animation: antHalo1  1.8s ease-in-out infinite; }
          .ant2      { animation: antBlink2 2.2s ease-in-out infinite 0.5s; }
          .ant2Halo  { animation: antHalo2  2.2s ease-in-out infinite 0.5s; }
          .ant3      { animation: antBlink3 1.5s ease-in-out infinite 1.1s; }
          .ant3Halo  { animation: antHalo3  1.5s ease-in-out infinite 1.1s; }

          /* Brillos puntiagudos — destello tipo lente óptico.
             Los polígonos .ant1/.ant2/.ant3 son la estrella de 4 puntas.
             Los .ant1Halo son el núcleo brillante interior. */
          @keyframes antBlink1 {
            0%,100% { opacity: 1;    fill: #dc0000; transform: scale(1);    }
            45%      { opacity: 0.08; fill: #800000; transform: scale(0.4);  }
            55%      { opacity: 1;    fill: #ff3030; transform: scale(1.25); }
          }
          @keyframes antHalo1 {
            0%,100% { opacity: 0.9; fill: #ff6060; transform: scale(1);   }
            45%      { opacity: 0;   fill: #ff0000; transform: scale(0.2); }
            55%      { opacity: 1;   fill: #ffffff; transform: scale(1.4); }
          }
          @keyframes antBlink2 {
            0%,100% { opacity: 1;    fill: #dc0000; transform: scale(1);    }
            40%      { opacity: 1;    fill: #ff2020; transform: scale(1.15); }
            50%      { opacity: 0.05; fill: #600000; transform: scale(0.3);  }
            60%      { opacity: 1;    fill: #dc0000; transform: scale(1.1);  }
          }
          @keyframes antHalo2 {
            0%,100% { opacity: 0.85; transform: scale(1);   }
            50%      { opacity: 0;    transform: scale(0.2); }
            60%      { opacity: 1;    transform: scale(1.3); }
          }
          @keyframes antBlink3 {
            0%,45%   { opacity: 1;    fill: #ff2020; transform: scale(1);    }
            50%,55%  { opacity: 0.04; fill: #500000; transform: scale(0.25); }
            60%,100% { opacity: 1;    fill: #dc0000; transform: scale(1);    }
          }
          @keyframes antHalo3 {
            0%,45%   { opacity: 0.8; transform: scale(1);   }
            50%,55%  { opacity: 0;   transform: scale(0.1); }
            60%,100% { opacity: 0.7; transform: scale(1.2); }
          }
        `}</style>


---
import styles from './Project.module.css';
import TextBox from '../TextBox/TextBox.astro';

export interface Project {
  id:       string;
  title:    string;
  description: string;
  logo:     string;
  logoAlt:  string;
  techs:    string[];
  link?:    string;
}

const projects: Project[] = [
  {
    id: 'proj-1',
    title: 'ALDEV.CL',
    description:
      'Portfolio personal construido con <strong>Astro</strong> y animaciones CSS puras. Temática <span class="kw">Persona Series</span> con secciones inspiradas en P3, P4 y P5. Diseño completamente custom sin frameworks de UI.',
    logo:    '/IMG/logo.svg',
    logoAlt: 'AL.DEV logo',
    techs:   ['Astro', 'TypeScript', 'CSS', 'React', 'Vercel'],
  },
  {
    id: 'proj-2',
    title: 'PROJECT ZERO',
    description:
      'API REST construida con <strong>Node.js</strong> y Express. Sistema de autenticación <span class="kw">JWT</span>, base de datos PostgreSQL y despliegue en Docker. Arquitectura limpia documentada con Swagger.',
    logo:    '/IMG/logo.svg',
    logoAlt: 'Project Zero logo',
    techs:   ['Node.js', 'PostgreSQL', 'Docker', 'TypeScript', 'Postman'],
  },
  {
    id: 'proj-3',
    title: 'MIDNIGHT APP',
    description:
      'Aplicación móvil desarrollada en <strong>Flutter</strong> con Firebase como backend. Notificaciones en <span class="kw">tiempo real</span>, autenticación con Google y almacenamiento en la nube.',
    logo:    '/IMG/logo.svg',
    logoAlt: 'Midnight App logo',
    techs:   ['Flutter', 'Firebase', 'Dart', 'SQLite', 'GitHub'],
  },
];


function pentagonPoints(cx: number, cy: number, r: number) {
  return Array.from({ length: 5 }, (_, i) => {
    const a = (Math.PI * 2 * i) / 5 - Math.PI / 2;
    return { x: cx + r * Math.cos(a), y: cy + r * Math.sin(a) };
  });
}

const C = 90;

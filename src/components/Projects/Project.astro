  <!-- ══ LISTA ══ -->
  <div class={styles.list}>
    {projects.map((p, idx) => {
      const outer = pentagonPoints(C, C, 72);
      const mid   = pentagonPoints(C, C, 48);
      const inner = pentagonPoints(C, C, 24);
      const polyO = outer.map(pt => `${pt.x},${pt.y}`).join(' ');
      const polyM = mid.map(pt => `${pt.x},${pt.y}`).join(' ');
      const polyI = inner.map(pt => `${pt.x},${pt.y}`).join(' ');
      const isAlt = idx % 2 === 1;

      return (
        <article class={styles.card} style={`--idx: ${idx}`} data-alt={isAlt}>

          <!-- número fantasma -->
          <div class={styles.cardIndex}>
            <span class={styles.cardIndexNum}>0{idx + 1}</span>
          </div>

          <!-- ══ STAR SIDE ══ -->
          <div class={`${styles.starSide} ${isAlt ? styles.starRight : ''}`}>
            <div class={styles.starRingOuter}></div>
            <div class={styles.starRingInner}></div>

            <svg
              class={styles.statStar}
              viewBox="0 0 180 180"
              xmlns="http://www.w3.org/2000/svg"
              aria-label={`Tecnologías de ${p.title}`}
            >
              {/* guías internas (pentágonos concéntricos) */}
              {(() => {
                const outer = pentagonPoints(C, C, 72);
                const mid   = pentagonPoints(C, C, 48);
                const inner = pentagonPoints(C, C, 24);
                const polyO = outer.map(pt => `${pt.x},${pt.y}`).join(' ');
                const polyM = mid.map(pt => `${pt.x},${pt.y}`).join(' ');
                const polyI = inner.map(pt => `${pt.x},${pt.y}`).join(' ');
                return (
                  <>
                    <polygon points={polyO} class={styles.starLineO} />
                    <polygon points={polyM} class={styles.starLineM} />
                    <polygon points={polyI} class={styles.starLineI} />
                    {outer.map(pt => (
                      <line x1={C} y1={C} x2={pt.x} y2={pt.y} class={styles.starAxis} />
                    ))}
                  </>
                );
              })()}

              {/* 5 puntas — cada punta normalizada apuntando al NORTE,
                  dentro de un <g rotate> que la lleva a su ángulo real.
                  CSS transform-box:fill-box + origin:center bottom
                  → scaleY siempre estira en el eje PROPIO de la punta. */}
              {Array.from({ length: 5 }, (_, i) => {
                const angleDeg = (360 * i) / 5;
                const outerR = 72, innerR = 30;
                const halfBase = Math.sin((Math.PI * 2 * 0.5) / 5) * innerR;
                const baseY    = C - Math.cos((Math.PI * 2 * 0.5) / 5) * innerR;
                const pts = `${C},${C - outerR} ${C - halfBase},${baseY} ${C},${C} ${C + halfBase},${baseY}`;
                return (
                  <g key={i} transform={`rotate(${angleDeg}, ${C}, ${C})`}>
                    <polygon
                      points={pts}
                      class={`${styles.starPoint} ${styles['starPoint' + (i+1)]}`}
                    />
                  </g>
                );
              })}

              <circle cx={C} cy={C} r="4" class={styles.starCore} />

              {/* labels de tecnologías en las puntas */}
              {Array.from({ length: 5 }, (_, i) => {
                const angle = (Math.PI * 2 * i) / 5 - Math.PI / 2;
                const lx = C + 90 * Math.cos(angle);
                const ly = C + 90 * Math.sin(angle);
                return (
                  <text key={i} x={lx} y={ly} class={styles.starLabel}
                    text-anchor="middle" dominant-baseline="middle">
                    {p.techs[i] ?? ''}
                  </text>
                );
              })}
            </svg>

            <!-- ══ PENTÁGONO central — cubre el centro de la estrella ══ -->
            {(() => {
              const pR    = 38;
              const pRin  = 32;
              const mkPts = (r: number) => Array.from({ length: 5 }, (_, i) => {
                const a = (Math.PI * 2 * i) / 5 - Math.PI / 2;
                return `${(C + r * Math.cos(a)).toFixed(2)},${(C + r * Math.sin(a)).toFixed(2)}`;
              }).join(' ');
              const outerPts = mkPts(pR);
              const innerPts = mkPts(pRin);
              return (
                <div class={styles.pentaFrame}>
                  <svg class={styles.pentaSvg} viewBox="0 0 180 180" xmlns="http://www.w3.org/2000/svg" overflow="visible">
                    {/* Capa posterior — color opuesto (rojo), offset abajo, z-index menor */}
                    <polygon points={outerPts} class={styles.pentaShadow} transform="translate(5,5)" />
                    {/* Capa frontal — negro, borde blanco, z-index mayor */}
                    <polygon points={outerPts} class={styles.pentaFront} />
                    {/* Línea interior decorativa */}
                    <polygon points={innerPts} class={styles.pentaInner} />
                  </svg>
                  {/* Logo centrado sobre el pentágono */}
                  <div class={styles.pentaIconSlot}>
                    <img src={p.logo} alt={p.logoAlt} class={styles.logoImg} />
                  </div>
                </div>
              );
            })()}
          </div>

          <!-- ══ DIALOG SIDE ══ -->
          <div class={`${styles.dialogSide} ${isAlt ? styles.dialogLeft : ''}`}>
            <!-- título botón -->
            <button
              class={styles.titleBtn}
              data-id={p.id}
              aria-label={`Ver detalle de ${p.title}`}
            >
              <span class={styles.titleSticker}></span>
              <span class={styles.titleMain}>{p.title}</span>
              <span class={styles.titleChevron}>▶</span>
            </button>

            <!-- TextBox con la forma P5 correcta -->
            <TextBox
              speaker={p.id.replace('proj-', 'PROJECT_') + '.md'}
              text={p.description}
              active={true}
            />

            <!-- tech tags: círculo principal z-index alto, pinchos detrás, sombra mínima -->
            <div class={styles.techTags}>
              {p.techs.map((t, ti) => {
                // Cantidad de pinchos varía 3–5 según índice
                const spikeCount = 3 + (ti % 3); // 3, 4, 5, 3, 4 ...
                const cx = 32, cy = 32;
                const rCircle = 26;
                const rBase   = 2.6;
                const rTip    = 40;
                const spikes = Array.from({ length: spikeCount }, (_, s) => {
                  const angle    = (Math.PI * 2 * s) / spikeCount - Math.PI / 2;
                  const perpAngle = angle + Math.PI / 2;
                  const bLx = cx + rCircle * Math.cos(angle) + rBase * Math.cos(perpAngle);
                  const bLy = cy + rCircle * Math.sin(angle) + rBase * Math.sin(perpAngle);
                  const bRx = cx + rCircle * Math.cos(angle) - rBase * Math.cos(perpAngle);
                  const bRy = cy + rCircle * Math.sin(angle) - rBase * Math.sin(perpAngle);
                  const tipX = cx + rTip * Math.cos(angle);
                  const tipY = cy + rTip * Math.sin(angle);
                  return `${bLx.toFixed(2)},${bLy.toFixed(2)} ${tipX.toFixed(2)},${tipY.toFixed(2)} ${bRx.toFixed(2)},${bRy.toFixed(2)}`;
                });
                return (
                  <span class={styles.techTag} style={`--ti: ${ti}; --sc: ${spikeCount}`}>
                    <svg class={styles.techTagBg} viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" overflow="visible">
                      {/* Pinchos — detrás del círculo */}
                      <g class={styles.techTagPins}>
                        {spikes.map((pts, si) => (
                          <polygon
                            key={si}
                            points={pts}
                            class={`${styles.techTagPin} ${styles[`techTagPin${(si % 5) + 1}`]}`}
                          />
                        ))}
                      </g>
                      {/* Círculo secundario (sombra) — mínimo offset, detrás */}
                      <circle cx="34" cy="34" r="26" class={styles.techTagShadowCircle}/>
                      {/* Círculo principal — z-index más alto */}
                      <circle cx="32" cy="32" r="26" class={styles.techTagCircle}/>
                    </svg>
                    <span class={styles.techTagText}>{t}</span>
                  </span>
                );
              })}
            </div>
          </div>

        </article>
      );
    })}
